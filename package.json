{
  "name": "kuramoto",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p ui/tsconfig.json",
    "test": "vitest run",
    "dev": "tsx src/cli.ts",
    "start": "vite build && tsx src/server.ts",
    "start:public": "vite build && KURAMOTO_PUBLIC=1 tsx src/server.ts",
    "build:ui": "vite build",
    "dev:ui": "vite",
    "e2e": "vite build && playwright test"
  },
  "devDependencies": {
    "@digital-go-jp/tailwind-theme-plugin": "^1.0.1",
    "@playwright/test": "^1.65.0",
    "@types/node": "^24.19.2",
    "@types/pngjs": "6.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "autoprefixer": "^10.6.2",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.319",
    "@anthropic-ai/sandbox-runtime": "0.0.81",
    "@dagrejs/dagre": "3.1.1",
    "@digital-go-jp/design-tokens": "^2.1.0",
    "@tanstack/react-query": "^5.107.1",
    "pixelmatch": "7.1.0",
    "pngjs": "7.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  }
}
